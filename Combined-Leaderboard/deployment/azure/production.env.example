# Compose and TLS
MS_VISTA_DOMAIN=leaderboard.example.org
ACME_EMAIL=leaderboard-admin@example.org
MS_VISTA_IMAGE_TAG=local
CADDY_IMAGE=caddy:2.11.4-alpine
MS_VISTA_DATA_DIR=/srv/ms-vista/data
MS_VISTA_BACKUP_DIR=/mnt/ms-vista-backups

# Public application URLs
FLASK_ENV=production
FLASK_DEBUG=false
DEPLOYMENT_MODE=public
FRONTEND_BASE_URL=https://leaderboard.example.org
API_BASE_URL=https://leaderboard.example.org
OAUTH_REDIRECT_BASE_URL=https://leaderboard.example.org
CORS_ORIGINS=https://leaderboard.example.org
PRIVACY_POLICY_URL=https://leaderboard.example.org/privacy

# Security and authentication
SECRET_KEY=replace-with-a-random-64-character-hex-value
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=ms_vista_session
SESSION_LIFETIME_DAYS=7
DISABLE_SUBMISSION_AUTH=false
AUTH_DEV_MODE=false
ALLOW_INSECURE_SECRET=false
ADMIN_EMAILS=admin@example.org

# Microsoft Entra authentication
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Azure Communication Services Email
# Configure exactly one authentication mode. The production VM currently uses
# ACS_CONNECTION_STRING; leave ACS_ENDPOINT empty in that mode.
ACS_CONNECTION_STRING=
ACS_ENDPOINT=
ACS_SENDER_ADDRESS=

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# Runtime controls
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
SQLITE_BUSY_TIMEOUT_MS=5000
HEALTH_CACHE_SECONDS=15
LIMITER_STORAGE_URI=memory://
AUTO_BACKUP_INTERVAL_HOURS=48
AUTO_BACKUP_RETENTION_COUNT=15
AUTO_BACKUP_POLL_SECONDS=300
AUTO_BACKUP_RUN_ON_START=true
MIN_FREE_DISK_BYTES=1073741824
MIN_FREE_DISK_PERCENT=5

# Private visual ground truth is mounted from the host, never built into images.
GROUND_TRUTHS_SOURCE=local
HF_TOKEN=
GROUND_TRUTHS_HF_REPO=
GROUND_TRUTHS_HF_REVISION=

# Spatial remains closed until the official bundle is released.
REQUIRE_OFFICIAL_SPATIAL=false
MAX_SPATIAL_SUBMISSION_BYTES=67108864
