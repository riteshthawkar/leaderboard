{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
}

{$MS_VISTA_DOMAIN} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy api:7860
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		# Shorten client addresses (IPv4 /24, IPv6 /48) so the access log cannot identify a
		# visitor, and drop the forwarding header, which would repeat the full address.
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>headers>X-Forwarded-For delete
			# Remove one-time sign-in values and the anti-forgery token from the log.
			request>uri query {
				delete code
				delete state
				delete session_state
			}
			request>headers>X-Csrf-Token delete
		}
	}
}
