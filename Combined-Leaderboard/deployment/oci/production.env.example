# Compose and TLS. Replace the example host with a DNS name that resolves to
# the reserved OCI public IP. A temporary <dashed-ip>.sslip.io host also works.
MS_VISTA_DOMAIN=api.example.org
ACME_EMAIL=leaderboard-admin@example.org
MS_VISTA_IMAGE_TAG=local
CADDY_IMAGE=caddy:2.11.4-alpine
MS_VISTA_DATA_DIR=/srv/ms-vista/data
MS_VISTA_BACKUP_DIR=/mnt/ms-vista-backups

# Public application URLs. Include the GitHub project path only in the frontend
# URL; CORS entries are origins and therefore do not include a path.
FLASK_ENV=production
FLASK_DEBUG=false
DEPLOYMENT_MODE=public
FRONTEND_BASE_URL=https://riteshthawkar.github.io/leaderboard
API_BASE_URL=https://api.example.org
OAUTH_REDIRECT_BASE_URL=https://api.example.org
CORS_ORIGINS=https://riteshthawkar.github.io,https://api.example.org
PRIVACY_POLICY_URL=https://riteshthawkar.github.io/leaderboard/privacy

# Retain the same-origin VM frontend as an emergency fallback while GitHub
# Pages uses bearer tokens across origins.
SECRET_KEY=replace-with-a-random-64-character-hex-value
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=ms_vista_session
SESSION_LIFETIME_DAYS=7
AUTH_TRANSPORT=dual
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
OAUTH_EXCHANGE_TTL_SECONDS=60
DISABLE_SUBMISSION_AUTH=false
AUTH_DEV_MODE=false
ALLOW_INSECURE_SECRET=false
ADMIN_EMAILS=admin@example.org

# Microsoft Entra authentication
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Azure Communication Services Email remains usable from OCI through its
# connection string. Configure exactly one ACS authentication mode.
ACS_CONNECTION_STRING=
ACS_ENDPOINT=
ACS_SENDER_ADDRESS=

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# Runtime and backup controls. The backup path must be a separately attached
# ext4 or XFS OCI block volume, not a directory on the boot filesystem.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
SQLITE_BUSY_TIMEOUT_MS=5000
HEALTH_CACHE_SECONDS=15
LIMITER_STORAGE_URI=memory://
AUTO_BACKUP_INTERVAL_HOURS=48
AUTO_BACKUP_RETENTION_COUNT=15
AUTO_BACKUP_POLL_SECONDS=300
AUTO_BACKUP_RUN_ON_START=true
BACKUP_VERIFY_ALLOWED_FSTYPES=ext4,xfs
MIN_FREE_DISK_BYTES=1073741824
MIN_FREE_DISK_PERCENT=5

# Private visual ground truth is copied to the protected host data directory
# and mounted read-only. It is never built into an image.
GROUND_TRUTHS_SOURCE=local
HF_TOKEN=
GROUND_TRUTHS_HF_REPO=
GROUND_TRUTHS_HF_REVISION=

# Keep Track 3 closed until the official public bundle is installed.
REQUIRE_OFFICIAL_SPATIAL=false
MAX_SPATIAL_ARCHIVE_BYTES=268435456
MAX_SPATIAL_MULTIPART_BYTES=272629760
MAX_SPATIAL_SUBMISSION_BYTES=67108864
